# Docker Compose automatically reads this file after copying it to .env.
# For local Python commands, export variables in your shell before starting Django.
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-hosting
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
# Optional alternative. OSRM's public default is a car profile.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
